{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    // `eslint.config.js` es JavaScript, pero ESLint necesita que forme parte de
    // un proyecto de TypeScript para poder analizarlo con reglas que consultan
    // tipos. Sin esto, ESLint falla al llegar a su propia configuracion.
    "allowJs": true,
    "checkJs": true,

    "composite": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    // Los imports explicitos .ts tambien se resuelven con el loader nativo.
    // Es compatible con noEmit: este proyecto no emite JavaScript con tsc.
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "vite.config.ts",
    "vite.config.test.ts",
    "eslint.config.js",
    // Configuracion de build de `Task/016`: genera `robots.txt`, cuya linea
    // `Sitemap:` depende del entorno y por eso no puede vivir en `public/`.
    "robots.config.ts",
    "robots.config.test.ts",
    "security.config.ts",
    "security.config.test.ts"
  ]
}
