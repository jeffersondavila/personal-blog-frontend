# ---------------------------------------------------------------------------
# personal-blog-frontend — .gitignore
# ---------------------------------------------------------------------------

# Secretos y configuración local
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Dependencias
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Build
dist/
dist-ssr/
build/
out/
.vite/
*.local

# Caché de herramientas
.eslintcache
.stylelintcache
.cache/
.turbo/
*.tsbuildinfo

# Pruebas y cobertura
coverage/
.nyc_output/
playwright-report/
test-results/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Temporales
tmp/
temp/
*.tmp
*.bak
*.orig
